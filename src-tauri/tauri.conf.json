{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zaapy",
  "identifier": "dev.miniluchi.zaapy",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Zaapy",
        "width": 420,
        "height": 400,
        "resizable": false,
        "visible": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdGNjY2M0ZBQjU2REUwRUMKUldUczRHMjErbU5tZjFQcEJtS1JkTXR1NGI0VVd2enc3dlB5ZWU1WHlKYVk4azZkYjFUNnNKSy8K",
      "endpoints": ["https://github.com/Miniluchi/zaapy/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Miniluchi",
    "copyright": "© 2026 Miniluchi",
    "category": "Utility",
    "shortDescription": "Ganymède travel commands, typed into Dofus 3 for you.",
    "longDescription": "Ganymède copies /travel x,y to the clipboard when you click a coordinate in a guide. Zaapy sits in the tray, notices it, raises the Dofus client you picked and types the command into its chat. It only reacts to a command copied while Ganymède was in front, and never types into a window it has not confirmed is in the foreground.",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": ["English", "French"],
        "displayLanguageSelector": true
      }
    }
  }
}
